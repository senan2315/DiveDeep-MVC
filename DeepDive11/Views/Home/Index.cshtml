@{
    ViewData["Title"] = "Forside";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="display-4 fw-bold mb-2">Dive Deep</h1>
        <p class="text-muted mb-0">Velkommen til vores dykkerunivers</p>
    </div>

    <section class="row justify-content-center mb-5">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="ratio ratio-16x9 bg-light">
                    <img src="~/images/vandbillede.jpg"
                         class="w-100 h-100 object-fit-cover"
                         alt="Undervandsbillede" />
                </div>
            </div>
        </div>
    </section>

    <section class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-grid gap-3 d-md-flex justify-content-md-center">
                    <a asp-controller="AboutUs" asp-action="Index"
                           class="btn btn-primary btn-lg px-4 rounded-pill">
                        Om os
                    </a>

                    <a asp-controller="Products" asp-action="Index"
                           class="btn btn-outline-primary btn-lg px-4 rounded-pill">
                        Dykkerudstyr
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
