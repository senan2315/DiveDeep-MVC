@{
    ViewData["Title"] = "Forside";
}

<div class="container py-5">
    <section class="bg-primary text-white rounded-4 shadow-lg p-4 p-lg-5 mb-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-light text-primary mb-3">Dive Deep</span>
                <h1 class="display-4 fw-bold mb-3">Velkommen til din næste undervandsoplevelse</h1>
                <p class="lead mb-4">
                    Scroll ned og vælg, hvor du vil hen.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="AboutUs" asp-action="Index" class="btn btn-light btn-lg fw-semibold">
                        Om os
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-light btn-lg fw-semibold">
                        Dykkerudstyr
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <img src="~/images/vandbillede.jpg" class="img-fluid rounded-4 shadow-sm w-100" alt="Undervandsbillede" />
            </div>
        </div>
    </section>

    <section id="valg">
        <div class="row g-4">
            <div class="col-md-6">
                <a asp-controller="AboutUs" asp-action="Index" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <img src="~/images/hvemervi.jpg" class="card-img-top" alt="Om os" />
                        <div class="card-body">
                            <h3 class="card-title fw-bold mb-0">Om os</h3>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-6">
                <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <img src="~/images/BCDGlide.webp" class="card-img-top" alt="Dykkerudstyr" />
                        <div class="card-body">
                            <h3 class="card-title fw-bold mb-0">Dykkerudstyr</h3>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </section>
</div>
