@using DeepDive11.Models
@using DeepDive11.Persistence
@model List<RentViewModel>
    

<div class="container py-5">

    <h1 class="text-center mb-5">Kurv</h1>

    <div class="row g-4">

        <div class="col-md-7">

            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h3 class="mb-4">Indkøbskurv</h3>

                    @if (TempData["BookingSuccess"] is string bookingSuccess)
                    {
                        <div class="alert alert-success">@bookingSuccess</div>
                        //hvis bookingen løkkedes vises der en grøn alert med en succes besked.
                    }

                    @if (TempData["BookingError"] is string bookingError)
                    {
                        <div class="alert alert-danger">@bookingError</div>
                    }

                    @if (Model.Count == 0)
                    {
                        <p>Din kurv er tom.</p>
                        //Hvis ikke der er nogen produkter i kurven, vises denne besked.
                    }
                    else
                    {
                        @foreach (var rent in Model)
                        {
                            var days = (rent.EndDate!.Value - rent.StartDate!.Value).Days;

                            <div class="bg-light rounded p-3 mb-3">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>
                                        <strong>@rent.Product!.Model</strong>

                                        @if (!string.IsNullOrEmpty(rent.SelectedSize))
                                        {
                                            <span class="text-muted">
                                                - Str. @rent.SelectedSize
                                            </span>
                                        }
                                    </div>

                                    <div>
                                        <strong>@rent.TotalPrice kr.</strong>
                                    </div>

                                    <div class="text-muted">
                                        @days dage
                                    </div>

                                </div>

                                <div class="mt-2 small text-muted">
                                    @rent.StartDate.Value.ToString("dd-MM-yyyy")
                                    -
                                    @rent.EndDate.Value.ToString("dd-MM-yyyy")
                                   
                                </div>

                            </div>
                        }
                    }

                </div>
            </div>

        </div>


        <div class="col-md-5">

            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h3 class="mb-4">Oversigt</h3>

                    <p>Pris for elementer:</p>

                    <h2 class="mb-4">
                        @Model.Sum(x => x.TotalPrice) kr.
                    </h2>

                    <form asp-controller="CheckOut" asp-action="CompleteBooking" method="post">
                        <button type="submit" class="btn btn-primary w-100 btn-lg" disabled="@(Model.Count == 0)">
                            Lej nu
                        </button>
                    </form>

                </div>
            </div>

        </div>

    </div>

</div>