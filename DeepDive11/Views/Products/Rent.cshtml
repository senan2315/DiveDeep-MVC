@model RentViewModel

<div class="container py-5">

    <div class="row">

        <div class="col-md-5">

            @if (!string.IsNullOrEmpty(Model.Product.Image))
            {
                <img src="~/images/@Model.Product.Image"
                     class="img-fluid"
                     alt="@Model.Product.Model" />
            }
            
        </div>

        <div class="col-md-7">

            <h1>@Model.Product.Model</h1>

            <p class="text-muted">@Model.Product.Brand</p>

            <h4>@Model.Product.PricePerDay kr. pr. dag</h4>

            <hr />
      
            <form asp-controller="CheckOut"
                  asp-action="AddToCart"
                  method="post">

                <input asp-for="Product.ProductId" type="hidden" />

                @if (Model.Product.Sizes != null && Model.Product.Sizes.Any())
                {
                    <div class="mb-3">

                        <label asp-for="SelectedSize" class="form-label">
                            Størrelse
                        </label>

                        <select asp-for="SelectedSize" class="form-select">

                            <option value="">Vælg størrelse</option>

                            @foreach (var size in Model.Product.Sizes)
                            {
                                <option value="@size">@size</option>
                            }

                        </select>

                    </div>
                }

                <div class="mb-3">

                    <label asp-for="Quantity" class="form-label">
                        Antal
                    </label>

                    <input asp-for="Quantity"
                           id="quantity"
                           type="number"
                           class="form-control"
                           min="1" />

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="StartDate" class="form-label">
                            Fra
                        </label>

                        <input asp-for="StartDate"
                               id="startDate"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="EndDate" class="form-label">
                            Til
                        </label>

                        <input asp-for="EndDate"
                               id="endDate"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="card mt-3">

                    <div class="card-body">

                        <p>
                            Pris pr. dag:
                            <strong>@Model.Product.PricePerDay kr.</strong>
                        </p>

                        <p>
                            Lejeperiode:
                            <strong>
                                <span id="days">0</span> dage
                            </strong>
                        </p>

                        <h4>
                            Total:
                            <span id="total">0</span> kr.
                        </h4>

                    </div>

                </div>

                <input asp-for="TotalPrice"
                       id="totalPrice"
                       type="hidden" />

                <button type="submit"
                        class="btn btn-primary btn-lg mt-3">
                    Tilføj til kurv
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const pricePerDay = @Model.Product.PricePerDay;

        const startDate = document.getElementById("startDate");
        const endDate = document.getElementById("endDate");
        const quantity = document.getElementById("quantity");

        const daysText = document.getElementById("days");
        const totalText = document.getElementById("total");


        function calculatePrice() {

            if (!startDate.value || !endDate.value) {
                daysText.textContent = "0";
                totalText.textContent = "0";
                document.getElementById("totalPrice").value = "0";
                return;
            }

            const start = new Date(startDate.value);
            const end = new Date(endDate.value);

            const difference = end - start;

            const days =
                Math.ceil(difference / (1000 * 60 * 60 * 24));

            if (days <= 0) {
                daysText.textContent = "0";
                totalText.textContent = "0";
                document.getElementById("totalPrice").value = "0";
                return;
            }

            const amount = parseInt(quantity.value) || 1;

            const total =
                days * pricePerDay * amount;

            daysText.textContent = days;
            totalText.textContent = total;
            document.getElementById("totalPrice").value = total;
        }


       
        endDate.addEventListener("change", calculatePrice);

        quantity.addEventListener("input", calculatePrice);

        startDate.addEventListener("change", function() {

            endDate.min = startDate.value;

            if (endDate.value && endDate.value < startDate.value) {
                endDate.value = startDate.value;
            }
           

            calculatePrice();
        });

    </script>

}
