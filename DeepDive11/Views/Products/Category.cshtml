@model List<DeepDive11.Models.Products>

<div class="container py-5">

    <h1 class="text-center mb-5">@ViewBag.Category</h1>

    <div class="row g-4">

        @foreach (var product in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(product.Image))
                    {
                        <img src="~/images/@product.Image"
                             class="produkt-billede"
                             alt="@product.Model" />
                    }

                    <div class="card-body text-center">

                        <h5 class="card-title">@product.Model</h5>

                        <p class="text-muted">@product.Brand</p>

                        @if (product.Type != null)
                        {
                            <p>
                                Type: <strong>@product.Type</strong>
                            </p>
                        }

                        @if (product.Thickness != null)
                        {
                            <p>
                                Tykkelse:
                                <strong>@product.Thickness mm</strong>
                            </p>
                        }
                        @if (product.Volume != null)
                        {
                            <p>
                                Volumen:
                                <strong>@product.Volume L</strong>
                            </p>
                        }
                        
                        @if (product.FirstStage != null)
                        {
                            <p>
                                1. trin:
                                <strong>@product.FirstStage</strong>
                            </p>
                        }

                        @if (product.SecondStage != null)
                        {
                            <p>
                                2. trin:
                                <strong>@product.SecondStage</strong>
                            </p>
                        }

                        @if (product.Octopus != null)
                        {
                            <p>
                                Octopus:
                                <strong>@product.Octopus</strong>
                            </p>
                        }

                        @if (product.IncludedItems != null && product.IncludedItems.Any())
                        {
                            <p class="mb-1">
                                <strong>Indeholder:</strong>
                            </p>

                            <ul class="list-unstyled">
                                @foreach (var item in product.IncludedItems)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }

                        <p class="fw-bold">
                            @product.PricePerDay /pr. dag
                        </p>

                        <a asp-controller="Products"
                           asp-action="Rent"
                           asp-route-id="@product.ProductId"
                           class="btn btn-primary">
                            Lej nu
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
