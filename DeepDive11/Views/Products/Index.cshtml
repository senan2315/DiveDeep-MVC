@model List<DeepDive11.Models.Products>

<div class="produkt-grid">

    @foreach (var product in Model)
    {
        <div class="produkt-kort">

            <h2>@product.Model</h2>

            <p>@product.Brand</p>

            <p>Fra @product.PricePerDay kr</p>

            <button>Lej nu</button>

        </div>
    }

</div>
