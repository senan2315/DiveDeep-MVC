@model DeepDive11.ViewModels.EditBookingViewModel

@{
    ViewData["Title"] = "Rediger booking";
}

<div class="container mt-4">

    <h1 class="mb-4">Rediger booking #@Model.BookingId</h1>

    <div class="mb-4">
        <p>
            <strong>Navn:</strong>
            @Model.Name
        </p>

        <p>
            <strong>Telefon:</strong>
            @Model.PhoneNumber
        </p>
    </div>

    <form asp-controller="Admin" asp-action="Edit" method="post">

        <input type="hidden" asp-for="BookingId" />

        <input type="hidden" asp-for="Name" />

        <input type="hidden" asp-for="PhoneNumber" />

        @for (int i = 0; i < Model.Products.Count; i++)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h4>
                        @Model.Products[i].ProductName
                    </h4>

                    <input type="hidden" asp-for="Products[i].ProductId" />

                    <input type="hidden" asp-for="Products[i].ProductName" />

                    <div class="mb-3">
                        <label asp-for="Products[i].StartDate" class="form-label">Startdato</label>

                        <input asp-for="Products[i].StartDate" type="date" class="form-control" />

                        <span asp-validation-for="Products[i].StartDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Products[i].EndDate" class="form-label">Slutdato</label>

                        <input asp-for="Products[i].EndDate" type="date" class="form-control"/>

                        <span asp-validation-for="Products[i].EndDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Products[i].Quantity" class="form-label">Antal</label>

                        <input asp-for="Products[i].Quantity" type="number" class="form-control" min="1" max="5" />

                        <span asp-validation-for="Products[i].Quantity" class="text-danger"></span>
                    </div>

                </div>

            </div>
        }

        <button type="submit" class="btn btn-primary">Gem ændringer</button>

        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Annuller</a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}