@page
@model PersonalDataModel

@{
    ViewData["Title"] = "Personlige data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>
            Din konto indeholder personlige oplysninger, som du har givet os.
            På denne side kan du downloade eller slette dine data.
        </p>

        <p>
            <strong>
                Hvis du sletter dine data, bliver din konto permanent slettet,
                og den kan ikke gendannes.
            </strong>
        </p>

        <form id="download-data"
              asp-page="DownloadPersonalData"
              method="post">

            <button class="btn btn-primary"
                    type="submit">
                Download data
            </button>
        </form>

        <p class="mt-3">
            <a id="delete"
                   asp-page="DeletePersonalData"
                   class="btn btn-danger">
                Slet konto
            </a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}